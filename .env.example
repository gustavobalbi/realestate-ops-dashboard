# Copy this file to .env and fill in your own key.
# Free-tier Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional. A random value is used by default if unset.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1

# Optional, only for the Azure App Service + Azure SQL Database deploy (see README
# "Deploy"). Leave all unset for local dev -- the app keeps using SQLite as above.
# AZURE_SQL_SERVER=
# AZURE_SQL_DATABASE=
# AZURE_SQL_USER=
# AZURE_SQL_PASSWORD=
# AZURE_SQL_READONLY_USER=assistente_ia
# AZURE_SQL_READONLY_PASSWORD=
# DJANGO_ALLOWED_HOSTS=
